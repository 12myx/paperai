# ---------------------------------------------------------------
# PaperLens AI environment configuration
# Copy to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------

# --- Required in production -----------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PAPERLENS_SECRET_KEY=change-me-to-a-random-48-character-secret

# --- Server -----------------------------------------------------
PAPERLENS_ENVIRONMENT=production
PAPERLENS_DATABASE_URL=sqlite:///./data/paperlens.db
# PostgreSQL example:
# PAPERLENS_DATABASE_URL=postgresql+psycopg://paperlens:password@db:5432/paperlens
PAPERLENS_STORAGE_DIR=./data/storage
PAPERLENS_CORS_ORIGINS=https://paperlens.example.com
PAPERLENS_MAX_UPLOAD_MB=50
PAPERLENS_MAX_PDF_PAGES=400

# --- Model provider (server-wide default) ----------------------
# Users can also configure their own encrypted key in Settings.
DEEPSEEK_API_KEY=
PAPERLENS_DEEPSEEK_BASE_URL=https://api.deepseek.com
PAPERLENS_DEEPSEEK_MODEL=deepseek-chat
PAPERLENS_LLM_TIMEOUT_SECONDS=180

# Optional: separate key used to encrypt per-user API keys.
# Defaults to PAPERLENS_SECRET_KEY.
# PAPERLENS_ENCRYPTION_KEY=